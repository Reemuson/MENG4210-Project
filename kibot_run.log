  version: 1

outputs:
- name: pdf_schematic
  comment: 'Schematic in PDF format'
  type: pdf_sch_print
  dir: 'Schematic'
  category: 'Schematic'
  options:
    background_color: false
    color_theme: 'Altium_Theme'
    default_font: 'KiCad Font'

definitions:
  NAME: pdf_schematic
  COMMENT: Schematic in PDF format
  COLOR_THEME: Altium_Theme
  DEFAULT_FONT: KiCad Font
  DIR: Schematic (kibot - config_reader.py:683)
