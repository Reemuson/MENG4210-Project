            color: '#000000'
          - layer: F.Cu
            color: '#F2F2F2'
          - layer: F.Mask
            color: '#E2E2E2'
          - layer: F.Paste
            color: '#E2E2E2'
          - layer: F.Silkscreen
            color: '#DBDBDB'
          - layer: F.Fab
