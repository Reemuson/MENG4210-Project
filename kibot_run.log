DEBUG:YAML after expanding definitions:
# KiBot preflight for Draw Fancy Stackup feature
# https://kibot.readthedocs.io/en/latest/configuration/preflights/draw_fancy_stackup.html

kibot:
  version: 1

preflight:
  draw_fancy_stackup:
    gerber: 'gbr_gerbers'
    gerber_extension_only: True
    draw_stackup: True
    draw_vias: True
    columns:
      - 'material'
      - 'layer'
      - 'thickness'
      - 'dielectric'
      - 'layer_type'
      - 'gerber'
